# Optional: enable real auth, database, and storage with Supabase.
# Copy this file to .env.local and fill in values from your Supabase project.
# Without these values, the app runs in local demo mode (data stays in your browser).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For GitHub OAuth in Supabase Auth, configure Google provider in Supabase dashboard.
# The app UI supports email sign-in; Supabase can be configured for Google/Gmail login.
